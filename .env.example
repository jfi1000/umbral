APP_NAME=UMBRAL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (prefer MySQL in production / CyberPanel) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=umbral
DB_USERNAME=umbral
DB_PASSWORD=

# Local smoke test without MySQL: switch to SQLite
# 1) touch database/database.sqlite
# 2) set DB_CONNECTION=sqlite
# 3) comment out DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD
# 4) php artisan migrate --seed
# DB_CONNECTION=sqlite
# # DB_HOST=127.0.0.1
# # DB_PORT=3306
# # DB_DATABASE=umbral
# # DB_USERNAME=umbral
# # DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@umbral.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Bible API (Catholic Spanish — Biblia de Jerusalén / BJ) ---
# EvanBible: https://evanbible.com/api/v1/bj
# GET /books
# GET /{book}                         (chapter count)
# GET /{book}/{chapter}               (all verses)
# GET /{book}/{chapter}/{verse}
# GET /random
# Http::timeout(5); on failure → seed_verses (≥100 curated BJ + deuterocanonical excerpts).
# Rights: BJ is publisher-owned on EvanBible (may return 410 if withdrawn). Not a full-text dump.
# Note: EvanBible BJ currently exposes 66 books; deuterocanonicals are seed-only.
BIBLE_API_BASE_URL=https://evanbible.com/api/v1/bj
